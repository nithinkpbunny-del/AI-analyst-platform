  },
  "fontSize": {
    "caption": "0.75rem",
    "small": "0.875rem",
    "body": "1rem",
    "h4": "1.25rem",
    "h3": "1.563rem",
    "h2": "1.953rem",
    "h1": "2.441rem",
    "hero": "3.815rem"
