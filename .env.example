# Copy this file to ".env" and fill in your own values:   cp .env.example .env
# ".env" is git-ignored. Never commit it, share it or paste its contents into a chat.
# Every variable the platform reads is listed here (BUILD_SPEC section 16 plus the safety limits of 6.5).

# --- Application ---------------------------------------------------------------------------------------------
APP_ENV=development                      # development | test | production
APP_BASE_URL=http://localhost:5173       # where the web app runs (also the allowed CORS origin)
API_BASE_URL=http://localhost:8000       # where the API runs
SITE_BASE_URL=http://localhost:4321      # marketing site
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR

# --- Databases & services (all run in Docker via "make dev") -------------------------------------------------
# These use "localhost" because your computer talks to the containers through published ports.
# docker-compose.yml overrides the host names for the containers (postgres, redis, minio, mailpit).
# The Postgres user, password and database name are taken from DATABASE_URL by "make dev".
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_DB_PASSWORD@localhost:5432/analyst
REDIS_URL=redis://localhost:6379/0

# --- File storage (MinIO in Docker; AWS S3 ap-south-1 in production) -----------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=analyst-dev
S3_ACCESS_KEY=CHANGE_ME_MINIO_USER       # also used as the MinIO root user locally
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD   # at least 8 characters; also the MinIO root password locally
S3_REGION=ap-south-1

# --- Security keys -------------------------------------------------------------------------------------------
# Generate each one separately with:   openssl rand -base64 32
MASTER_KEY=                              # encrypts 2FA secrets, connection credentials and BYOK keys (required; KMS_KEY_ID in production)
KMS_KEY_ID=                              # production only: AWS KMS key id that replaces MASTER_KEY
JWT_SECRET=                              # signs access tokens and the device cookie (required)
ACCESS_TOKEN_MINUTES=10                  # access-token lifetime
SESSION_IDLE_MINUTES=30                  # auto logout after this much inactivity
SESSION_MAX_HOURS=12                     # absolute session length
# Optional (defaults shown; BUILD_SPEC 6.1):
# LOGIN_MAX_FAILURES=5                   # failed sign-ins per email + IP before a lockout...
# LOGIN_WINDOW_MINUTES=15                # ...within this window; repeated lockouts double in length
# EMAIL_VERIFICATION_HOURS=24            # how long the "confirm your email" link works
# PASSWORD_RESET_MINUTES=60              # how long a password-reset link works
# COOKIE_SECURE=auto                     # auto | true | false. auto = Secure cookies unless the API is http://localhost
# POLICY_VERSION=2026-11-09              # privacy policy + terms version recorded when someone signs up

# --- Email (Mailpit in Docker catches all mail; open http://localhost:8025) ----------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Analyst Agent <no-reply@localhost>

# --- AI ------------------------------------------------------------------------------------------------------
# The platform's own keys, used by workspaces on the Managed AI plan (BYOK workspaces paste their own key in
# Settings; it is stored encrypted, never here). Setup: docs/SETUP_AI.md. Check a key with: make llm-check
LLM_DEFAULT_PROVIDER=gemini              # gemini | claude: which platform key Managed AI uses
GEMINI_API_KEY=                          # Google AI Studio key (free tier is fine for development)
GEMINI_API_VERSION=v1beta                # function calling is not available on "v1"
GEMINI_DEFAULT_MODEL=                    # optional; empty = the newest stable Flash model the key can use
ANTHROPIC_API_KEY=                       # optional: only if you want Claude as the provider
CLAUDE_DEFAULT_MODEL=claude-opus-5-5     # used when the key offers it, else the newest Opus/Sonnet/Haiku

# --- Limits (defaults come from BUILD_SPEC 6.5; uncomment to change) -----------------------------------------
CACHE_TTL_SECONDS=300                    # reuse data fetched within this many seconds
SNAPSHOT_MAX_AGE_HOURS=24                # cached dataset snapshots are purged after this long
MANAGED_MONTHLY_QUESTION_LIMIT=500       # questions per organisation per month on the Managed AI plan
# Billing hooks (M18). There is NO payment provider yet: "stand_in" is the only value and it sends and charges
# nothing. Plan changes, 80%/100% usage warnings and monthly usage summaries are recorded for a future provider.
# BILLING_PROVIDER=stand_in
# AGENT_MAX_STEPS=12
# AGENT_MAX_STEPS_LONG_TASK=40
# LLM_MAX_OUTPUT_TOKENS=3000
# LLM_REQUEST_TIMEOUT_SECONDS=60         # one request to the AI provider (Gemini also uses it as its deadline)
# LLM_CALL_BUDGET_SECONDS=150            # one AI call with its retries and model fallbacks; no new attempt after
# DICTIONARY_AI_MAX_OUTPUT_TOKENS=6000   # the AI's answer when it drafts the business dictionary (includes thinking)
# DICTIONARY_AI_TABLES_PER_CALL=8        # tables described per AI call when drafting the dictionary
# TOKEN_BUDGET_PER_QUESTION=150000
# ROWS_TO_LLM_PER_TOOL_CALL=200
# SOURCE_QUERY_TIMEOUT_SECONDS=30
# SOURCE_QUERY_TIMEOUT_LONG_TASK_SECONDS=120
# MAX_ROWS_PER_DATASET=1000000
# QUESTIONS_PER_USER_PER_MINUTE=10
# CONCURRENT_LONG_TASKS_PER_ORG=2
# UPLOAD_MAX_MB=50
# HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# --- Google: "Continue with Google" sign-in (M3) and the Google Sheets connector (M6) -----------------------------
# Leave empty to use the local stand-ins in development (nothing goes to Google). Setup steps: docs/SETUP_GOOGLE.md
# Redirect URIs to register with Google: <API_BASE_URL>/auth/google/callback (sign-in) and
# <API_BASE_URL>/connections/google/callback (Sheets).
# Real Google Sheets needs all four values; sign-in needs only the first two.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=                   # browser API key restricted to the Google Picker API
GOOGLE_CLOUD_PROJECT_NUMBER=             # the project NUMBER (digits, e.g. 123456789012), not its id

# --- Razorpay connector (M11) -------------------------------------------------------------------------------
# Keys are entered by an Owner in the app (Connections > Add data), never here. In development, a key id starting
# with rzp_test_demo is answered by a local stand-in serving the demo payments; any other key goes to Razorpay.
# RAZORPAY_HISTORY_DAYS=365                # how far back the first read goes
# RAZORPAY_REFRESH_LOOKBACK_DAYS=30        # later reads start this many days before the newest row

# --- Shopify connector (M12; docs/SETUP_SHOPIFY.md) ---------------------------------------------------------
# The Shopify app's Client ID and Client secret (Shopify Partners / Dev Dashboard > your app > Settings). Leave both
# empty in development to use the local stand-in: "Connect Shopify" then reads the demo store on this computer.
# Outside development, Shopify stays off until both are set.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SHOPIFY_SCOPES=read_orders,read_products,read_customers,read_inventory   # read scopes only; others are dropped.
#                                          # Add read_all_orders once Shopify approves it (orders older than 60 days).
# SHOPIFY_API_VERSION=2026-07              # Admin GraphQL API version; move it forward before Shopify retires it
# SHOPIFY_HISTORY_DAYS=730                 # how far back the first read of orders goes
# SHOPIFY_BULK_THRESHOLD=1000              # a first read of a bigger table uses one bulk export instead of pages
# SHOPIFY_BULK_TIMEOUT_SECONDS=900         # how long to wait for Shopify to prepare a bulk export

# --- Zoho Books connector (M13; docs/SETUP_ZOHO.md) --------------------------------------------------------
# The Zoho API client's Client ID and Client Secret (api-console.zoho.in > your Server-based Application). Leave both
# empty in development to use the local stand-in: "Connect Zoho Books" then reads a demo organisation on this
# computer. Outside development, Zoho Books stays off until both are set.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# ZOHO_REGION=in                           # Zoho data centre for sign-in: in (India), com, eu, com.au, jp, ca, sa.
#                                          # People whose Zoho account is in another data centre are sent back with
#                                          # theirs and it is used for them (enable "Multi-DC" on the client).
# ZOHO_SCOPES=                             # read scopes only (ZohoBooks.<module>.READ); empty = the defaults
# ZOHO_HISTORY_DAYS=730                    # how far back the first read of invoices, bills and expenses goes
# ZOHO_REPORT_MONTHS=24                    # months of profit and loss read (one API call per month)
# ZOHO_DAILY_CALL_LIMIT=1000               # your Zoho Books plan's daily API calls per organisation (Free 1,000;
#                                          # Standard 2,000; Professional 5,000; Premium and above 10,000)

# --- PostgreSQL / MySQL connector (M14; docs/SETUP_DATABASES.md) -------------------------------------------
# Owners enter database credentials in the app (Connections > Add data > Connect a database), never here.
# Private and internal addresses are always refused, except these host names in development (the demo databases
# that "make dev" starts). Ignored outside development.
# DB_DEV_ALLOWED_HOSTS=demo-postgres,demo-mysql
# DB_CONNECT_TIMEOUT_SECONDS=10            # how long to wait for a database to accept a connection
# DB_FETCH_CHUNK_ROWS=10000                # rows per round trip while a table is read

# --- Tally bridge (M16; docs/SETUP_TALLY.md) -----------------------------------------------------------------
# Tally runs on the customer's PC: the Tally bridge there pairs with a one-time code and pushes data to
# API_BASE_URL (which must be https:// outside development). No credentials are needed here. All optional.
# TALLY_PAIRING_CODE_MINUTES=10            # a pairing code works once and only this long
# TALLY_SYNC_INTERVAL_MINUTES=15           # the bridge reads Tally this often (and when "Refresh now" is pressed)
# TALLY_FULL_SYNC_HOURS=24                 # a full read (which also removes deleted vouchers) at least this often
# TALLY_HISTORY_MONTHS=36                  # months of vouchers read
# TALLY_MAX_BATCH_ROWS=2000                # rows per batch from the bridge
# TALLY_MAX_BATCH_BYTES=2000000            # bytes per batch (also after un-gzipping)
# TALLY_OFFLINE_AFTER_MINUTES=5            # no heartbeat this long: "Tally PC offline since ..."
# TALLY_POLL_WAIT_SECONDS=25               # longest wait of the bridge's long-poll for "read again now"
# TALLY_BRIDGE_DOWNLOAD_URL=               # where Owners download the Windows bridge (shown when pairing)
