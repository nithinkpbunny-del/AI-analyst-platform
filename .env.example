# Copy this file to ".env" and fill in your own values:   cp .env.example .env
# ".env" is git-ignored. Never commit it, share it or paste its contents into a chat.
# Every variable the platform reads is listed here (BUILD_SPEC section 16 plus the safety limits of 6.5).

# --- Application ---------------------------------------------------------------------------------------------
APP_ENV=development                      # development | test | production
APP_BASE_URL=http://localhost:5173       # where the web app runs (also the allowed CORS origin)
API_BASE_URL=http://localhost:8000       # where the API runs
SITE_BASE_URL=http://localhost:4321      # marketing site
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR

# --- Databases & services (all run in Docker via "make dev") -------------------------------------------------
# These use "localhost" because your computer talks to the containers through published ports.
# docker-compose.yml overrides the host names for the containers (postgres, redis, minio, mailpit).
# The Postgres user, password and database name are taken from DATABASE_URL by "make dev".
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_DB_PASSWORD@localhost:5432/analyst
REDIS_URL=redis://localhost:6379/0

# --- File storage (MinIO in Docker; AWS S3 ap-south-1 in production) -----------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=analyst-dev
S3_ACCESS_KEY=CHANGE_ME_MINIO_USER       # also used as the MinIO root user locally
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD   # at least 8 characters; also the MinIO root password locally
S3_REGION=ap-south-1

# --- Security keys -------------------------------------------------------------------------------------------
# Generate each one separately with:   openssl rand -base64 32
MASTER_KEY=                              # encrypts 2FA secrets, connection credentials and BYOK keys (required; KMS_KEY_ID in production)
KMS_KEY_ID=                              # production only: AWS KMS key id that replaces MASTER_KEY
JWT_SECRET=                              # signs access tokens and the device cookie (required)
ACCESS_TOKEN_MINUTES=10                  # access-token lifetime
SESSION_IDLE_MINUTES=30                  # auto logout after this much inactivity
SESSION_MAX_HOURS=12                     # absolute session length
# Optional (defaults shown; BUILD_SPEC 6.1):
# LOGIN_MAX_FAILURES=5                   # failed sign-ins per email + IP before a lockout...
# LOGIN_WINDOW_MINUTES=15                # ...within this window; repeated lockouts double in length
# EMAIL_VERIFICATION_HOURS=24            # how long the "confirm your email" link works
# PASSWORD_RESET_MINUTES=60              # how long a password-reset link works
# COOKIE_SECURE=auto                     # auto | true | false. auto = Secure cookies unless the API is http://localhost
# POLICY_VERSION=2026-11-09              # privacy policy + terms version recorded when someone signs up

# --- Email (Mailpit in Docker catches all mail; open http://localhost:8025) ----------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Analyst Agent <no-reply@localhost>

# --- AI ------------------------------------------------------------------------------------------------------
# The platform's own keys, used by workspaces on the Managed AI plan (BYOK workspaces paste their own key in
# Settings; it is stored encrypted, never here). Setup: docs/SETUP_AI.md. Check a key with: make llm-check
LLM_DEFAULT_PROVIDER=gemini              # gemini | claude: which platform key Managed AI uses
GEMINI_API_KEY=                          # Google AI Studio key (free tier is fine for development)
GEMINI_API_VERSION=v1beta                # function calling is not available on "v1"
GEMINI_DEFAULT_MODEL=                    # optional; empty = the newest stable Flash model the key can use
ANTHROPIC_API_KEY=                       # optional: only if you want Claude as the provider
CLAUDE_DEFAULT_MODEL=claude-opus-5-5     # used when the key offers it, else the newest Opus/Sonnet/Haiku

# --- Limits (defaults come from BUILD_SPEC 6.5; uncomment to change) -----------------------------------------
CACHE_TTL_SECONDS=300                    # reuse data fetched within this many seconds
SNAPSHOT_MAX_AGE_HOURS=24                # cached dataset snapshots are purged after this long
MANAGED_MONTHLY_QUESTION_LIMIT=500       # questions per organisation per month on the Managed AI plan
# AGENT_MAX_STEPS=12
# AGENT_MAX_STEPS_LONG_TASK=40
# LLM_MAX_OUTPUT_TOKENS=3000
# LLM_REQUEST_TIMEOUT_SECONDS=60         # one request to the AI provider (Gemini also uses it as its deadline)
# LLM_CALL_BUDGET_SECONDS=150            # one AI call with its retries and model fallbacks; no new attempt after
# TOKEN_BUDGET_PER_QUESTION=150000
# ROWS_TO_LLM_PER_TOOL_CALL=200
# SOURCE_QUERY_TIMEOUT_SECONDS=30
# SOURCE_QUERY_TIMEOUT_LONG_TASK_SECONDS=120
# MAX_ROWS_PER_DATASET=1000000
# QUESTIONS_PER_USER_PER_MINUTE=10
# CONCURRENT_LONG_TASKS_PER_ORG=2
# UPLOAD_MAX_MB=50
# HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# --- Google: "Continue with Google" sign-in now (M3), the Sheets connector later (M6) ----------------------------
# Leave empty to use the local stand-in page in development. Setup steps: docs/SETUP_GOOGLE.md
# Redirect URI to register with Google: <API_BASE_URL>/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=                   # M6 (Google Sheets picker)

# --- Connectors: fill in later, when the milestone asks for them (leave empty for now) -----------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
